# Packages for the personal machine, on top of Brewfile.

brew "rclone"
brew "esphome"

# Containers: Colima is the VM that runs them; docker and docker-compose
# are just the CLI and its Compose plugin (no Docker Desktop). One-time,
# with a fixed disk size: colima start --cpu 4 --memory 8 --disk 30
brew "colima"
brew "docker"
brew "docker-compose"

cask "orcaslicer"
cask "tailscale-app"
cask "google-earth-pro"

# Installed by hand, on purpose:
#   - Autodesk Fusion: ships its own updater and uninstaller, which fight
#     with the cask
#   - DaVinci Resolve: no cask, the download sits behind a registration form
#   - Raspberry Pi Imager: brew install --cask raspberry-pi-imager, when needed
