# Homebrew lives in /opt/homebrew on Apple Silicon, which is not on the
# default PATH. Load it first so everything below can find brew's tools.
eval "$(/opt/homebrew/bin/brew shellenv zsh)"

# Personal scripts from the dotfiles repo's bin/ (linked by shell.sh), and
# the Claude Code CLI, which its native installer puts here.
export PATH="$HOME/.local/bin:$PATH"

export LANG=en_US.UTF-8

# - - - History - - -
# macOS keeps 1000 entries and only writes them when a shell exits;
# share_history makes each command available in other tabs right away.

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history
setopt extended_history       # store timestamps
setopt hist_ignore_all_dups
setopt hist_ignore_space      # a leading space keeps a command (and any token in it) out

# - - - Completion - - -

autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' menu select                       # arrow through matches

# - - - Keybindings - - -
# Emacs mode, set explicitly: zsh picks vi mode on its own when $EDITOR or
# $VISUAL mentions vi. Up/Down search history for lines starting with
# whatever is already typed.

bindkey -e

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# - - - Tools - - -

# Node: switch to the version in a repo's .nvmrc on cd. fnm keeps that
# version after leaving the repo; `fnm use default` goes back. The prompt
# already shows the active version, so only errors are printed (a missing
# version still offers to install itself).
eval "$(fnm env --use-on-cd --log-level error --shell zsh)"

# Ctrl+R fuzzy history search, Ctrl+T fuzzy file picker.
source <(fzf --zsh)

eval "$(starship init zsh)"

# Load machine-specific config if exists (not versioned)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Plugins go last: syntax highlighting must load after every other widget
# is defined, including any from ~/.zshrc.local.
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
