# Machine-specific shell config
# Copied to ~/.zshrc.local by shell.sh, and NOT versioned in git: this
# repo is public, so tokens and employer- or client-specific bits go here.
#
# Sourced by ~/.zshrc after everything else except the zsh plugins.

# Example: a token a package registry needs
# export NPM_TOKEN=...

# Example: a second Claude Code account. ~/.claude stays the machine's own
# account; the wrapper points the CLI at a separate config directory.
# The Keychain item name derives from a hash of this exact path, so never
# change its spelling (a trailing slash yields a different item and a lost
# login).
# claude-personal() {
#   CLAUDE_CONFIG_DIR="$HOME/.claude-personal" command claude "$@"
# }
