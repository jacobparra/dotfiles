# Machine-specific SSH config
# Copied to ~/.ssh/config.local by shell.sh and NOT versioned in git:
# this repo is public, so anything host-, employer- or client-specific
# belongs here rather than in the tracked config.
#
# Keys are generated on each machine and never copied between them, and
# each machine only lists the hosts it should reach. GitHub needs no
# block: github.sh has gh create ~/.ssh/id_ed25519, which ssh tries on
# its own.

# - - - Work - - -

# Host gitlab.example.com
#   IdentityFile ~/.ssh/gitlab_ed25519
#   IdentitiesOnly yes

# - - - Personal servers - - -

# Host homelab
#   HostName homelab.example.com
#   User jacob
#   IdentityFile ~/.ssh/personal_ed25519
#   IdentitiesOnly yes

# - - - Hosts sharing a domain - - -
# %h expands to the alias typed on the command line, so several hosts
# under one domain need a single block: `ssh staging` resolves to
# staging.example.com
# Host staging prod
#   HostName %h.example.com
#   User jacob
#   IdentityFile ~/.ssh/client_ed25519
#   IdentitiesOnly yes
